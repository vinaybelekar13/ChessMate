# ============================================================
# LOCAL DEVELOPMENT (default) — SQLite, no Docker, no Postgres.
# Just `pip install -r requirements.txt` and run uvicorn (see README.md).
# ============================================================
DATABASE_URL=sqlite:///./bookcoach.db

# ============================================================
# PRODUCTION OPTION — swap in Postgres, no code changes needed
# (SQLModel/SQLAlchemy abstracts it). Uncomment and fill in:
# DATABASE_URL=postgresql://bookcoach:bookcoach@localhost:5432/bookcoach
# ============================================================

# Object storage (local dev = filesystem path; prod = s3://bucket, not implemented)
STORAGE_ROOT=./storage

# LLM (storytelling + Search Mode synthesis — never used for curriculum ordering).
# Leave blank to run in LOCAL GROUNDED MODE (no invented content, no API
# calls, works fully offline) — see app/coach/local_coach.py.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-6

# MinerU / Docling — both optional. If neither is installed/available, the
# app automatically falls back to local_pdf_adapter.py (pdfplumber-based,
# always available since it's a normal pip package). See app/ingestion/pipeline.py.
MINERU_MODE=cli
MINERU_BIN=magic-pdf
DOCLING_ENABLED=true

# Stockfish — optional, supplementary only. If the binary isn't found on
# PATH (or at this exact path), the app returns a labeled "unavailable"
# result instead of fabricating an evaluation. See app/chess/engine.py.
STOCKFISH_PATH=stockfish

# CORS — the static ChessMate frontend's origin(s)
ALLOWED_ORIGINS=http://localhost:8000,https://barabosik.github.io
